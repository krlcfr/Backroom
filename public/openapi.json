{
  "openapi": "3.0.0",
  "info": {
    "title": "BackRoom API",
    "description": "Documentación interactiva de la API de BackRoom (MVP v8.0). Define los contratos de entrada y salida para cada endpoint, incluyendo Autenticación, BackRooms, Salas, Recursos y Auditoría.",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000/api",
      "description": "Servidor Local (Desarrollo)"
    }
  ],
  "components": {
    "schemas": {
      "Usuario": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "username": { "type": "string" },
          "correo": { "type": "string", "format": "email" },
          "nombre_completo": { "type": "string" },
          "es_superadmin": { "type": "boolean" },
          "activo": { "type": "boolean" }
        }
      },
      "Organizacion": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nombre": { "type": "string", "example": "Mi Empresa SAS" },
          "descripcion": { "type": "string" },
          "owner_id": { "type": "string", "format": "uuid" },
          "created_at": { "type": "string", "format": "date-time" }
        }
      },
      "BackRoom": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nombre": { "type": "string", "example": "Proyecto Alpha" },
          "organizacion_id": { "type": "string", "format": "uuid" }
        }
      },
      "Sala": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nombre": { "type": "string", "example": "Recursos Humanos" },
          "parent_id": { "type": "string", "format": "uuid", "nullable": true },
          "backroom_id": { "type": "string", "format": "uuid" }
        }
      },
      "Recurso": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "nombre": { "type": "string", "example": "informe_financiero.pdf" },
          "tipo": { "type": "string", "example": "archivo" },
          "url": { "type": "string", "format": "uri" },
          "size_bytes": { "type": "integer", "example": 1048576 }
        }
      },
      "AuditoriaLog": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "accion": { "type": "string", "example": "SALA_CREADA" },
          "usuario_id": { "type": "string", "format": "uuid" },
          "fecha": { "type": "string", "format": "date-time" }
        }
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": { "type": "string", "example": "RATE_LIMIT" },
              "message": { "type": "string", "example": "Demasiados intentos. Inténtalo más tarde." }
            }
          }
        }
      }
    }
  },
  "paths": {
    "/auth/me": {
      "get": {
        "summary": "Obtener perfil del usuario",
        "description": "Verifica las cookies HttpOnly y devuelve los datos del usuario activo.",
        "tags": ["Autenticación"],
        "responses": {
          "200": { "description": "Sesión activa.", "content": { "application/json": { "schema": { "": "#/components/schemas/Usuario" } } } },
          "401": { "description": "No autorizado" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "summary": "Cerrar sesión",
        "tags": ["Autenticación"],
        "responses": {
          "200": { "description": "Sesión cerrada." }
        }
      }
    },
    "/organizations": {
      "post": {
        "summary": "Crear nueva organización",
        "tags": ["Organizaciones"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": { "type": "string", "example": "Tech Corp" },
                  "descripcion": { "type": "string" }
                },
                "required": ["nombre"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Organización creada", "content": { "application/json": { "schema": { "": "#/components/schemas/Organizacion" } } } },
          "409": { "description": "Conflicto" }
        }
      }
    },
    "/backrooms": {
      "get": {
        "summary": "Listar BackRooms",
        "tags": ["BackRooms"],
        "responses": {
          "200": { "description": "Lista de BackRooms", "content": { "application/json": { "schema": { "type": "array", "items": { "": "#/components/schemas/BackRoom" } } } } }
        }
      },
      "post": {
        "summary": "Crear un BackRoom",
        "tags": ["BackRooms"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "nombre": { "type": "string", "example": "Contabilidad 2026" },
                  "descripcion": { "type": "string" }
                },
                "required": ["nombre"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "BackRoom creado" }
        }
      }
    },
    "/rooms/{roomId}/tree": {
      "get": {
        "summary": "Obtener árbol de subsalas",
        "description": "Devuelve la estructura recursiva de una sala.",
        "tags": ["Salas (Rooms)"],
        "parameters": [
          {
            "name": "roomId",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" },
            "description": "ID de la sala padre"
          }
        ],
        "responses": {
          "200": { "description": "Árbol de salas devuelto" },
          "403": { "description": "Sin acceso a esta sala" }
        }
      }
    },
    "/resources": {
      "post": {
        "summary": "Subir un recurso (Archivo o Enlace)",
        "description": "Sube un archivo al almacenamiento (Supabase Storage) o registra un enlace.",
        "tags": ["Recursos"],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "file": { "type": "string", "format": "binary" },
                  "sala_id": { "type": "string", "format": "uuid" }
                },
                "required": ["file", "sala_id"]
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Recurso subido exitosamente", "content": { "application/json": { "schema": { "": "#/components/schemas/Recurso" } } } },
          "413": { "description": "Límite de almacenamiento excedido" }
        }
      }
    },
    "/invitations": {
      "post": {
        "summary": "Crear invitación a la Organización",
        "description": "Genera un enlace o token para invitar a un nuevo miembro.",
        "tags": ["Invitaciones"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "correo": { "type": "string", "format": "email" },
                  "rol": { "type": "string", "enum": ["admin", "miembro"] }
                },
                "required": ["correo"]
              }
            }
          }
        },
        "responses": {
          "200": { "description": "Invitación enviada/generada" }
        }
      }
    },
    "/audit": {
      "get": {
        "summary": "Consultar Logs de Auditoría",
        "description": "Devuelve el registro de actividades de la organización (solo admins).",
        "tags": ["Auditoría"],
        "responses": {
          "200": { "description": "Historial devuelto", "content": { "application/json": { "schema": { "type": "array", "items": { "": "#/components/schemas/AuditoriaLog" } } } } }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Verificar estado del sistema",
        "tags": ["Sistema"],
        "responses": {
          "200": { "description": "Sistema funcionando" }
        }
      }
    }
  }
}
