# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# documentacion del proyecto (vive en un repo/carpeta separada, no aplica aqui)
docs/

# configuracion local del editor
.vscode/


