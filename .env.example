# Supabase — URL del proyecto (Dashboard > Settings > API > Project URL)
# Formato: https://<referencia-proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co

# Supabase — clave publica anonima (Dashboard > Settings > API > anon public)
# Segura de exponer al navegador, respeta Row Level Security (RLS)
# Formato: JWT (eyJ...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase — clave de servicio (Dashboard > Settings > API > service_role)
# NUNCA exponer al navegador, salta Row Level Security (RLS) por completo
# Solo se usa en scripts administrativos (ej. seeds/superadmin.ts)
# Formato: JWT (eyJ...)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# URL publica donde corre el sitio, usada para construir links de correo
# (confirmacion de cuenta, recuperacion de contrasena)
# En desarrollo: http://localhost:3000
# En produccion: la URL real del dominio desplegado
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Google reCAPTCHA v2 (checkbox "No soy un robot") en login y registro
# Clave publica del sitio (Consola reCAPTCHA > Claves). Segura de exponer al navegador.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Google reCAPTCHA v2 — clave secreta (Consola reCAPTCHA > Claves)
# NUNCA exponer al navegador. Se usa server-side en /api/auth/login y /api/auth/register
# Formato: 6Lxxxx (secret key)
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Credenciales para el script de seed del SuperAdmin inicial (npm run seed:superadmin)
# Usar un correo real accesible, no se envia confirmacion por este medio
SUPERADMIN_EMAIL=admin@ejemplo.com

# Minimo 8 caracteres
SUPERADMIN_PASSWORD=una-contrasena-segura-aqui
